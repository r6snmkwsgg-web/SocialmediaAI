# Hookline's settings. Copy to .env.local for development; in a deploy, set
# these in the host's environment (Vercel for the app, wherever the worker
# runs for the worker). Never commit real values. Everything but a database
# is optional: what isn't set shows as "not set up" in the app.

# ── basics ──
# the site's address, no trailing slash (sign-in links and OAuth redirects use it)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Postgres. On Supabase: Project settings, Database, the "Transaction pooler" connection string
DATABASE_URL=
# 32 random bytes, base64: encrypts OAuth tokens and Stripe keys. Make one with: openssl rand -base64 32
TOKEN_KEY=
# any long random string; a scheduler sends it to /api/cron/* as "Authorization: Bearer <it>"
CRON_SECRET=
# local development only: sign in without email. Never set in a deploy (it's ignored in production builds anyway)
HOOKLINE_DEV_LOGIN=
# shown on the privacy and terms pages
NEXT_PUBLIC_CONTACT_EMAIL=
# who can open /admin (sign-ups, plans, the render queue, problems): emails, comma-separated
ADMIN_EMAILS=

# ── Supabase (sign-in and video storage) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server and worker only: storage and deleting accounts
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (plans) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_CREATOR_MONTH=
STRIPE_PRICE_CREATOR_YEAR=

# ── Claude (titles) ──
ANTHROPIC_API_KEY=
# the Claude model id that writes titles (see Anthropic's models page)
ANTHROPIC_MODEL=

# ── Google and YouTube ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# a YouTube Data API key: Trends, and view counts for the learning loop
YOUTUBE_API_KEY=
# your own YouTube channel IDs (UC...), comma-separated. Until YouTube's API audit
# passes, everything Hookline uploads stays private, so it only uploads to these;
# everyone else posts their own Shorts and Hookline checks the links (see NEXT.md)
YOUTUBE_TEST_CHANNELS=
# 1 once the audit has passed: Hookline uploads for every channel
YOUTUBE_AUDITED=
# what Google allows Hookline's project a day once it grants more, as whole numbers: set exactly what
# it grants. Left empty, they're Google's defaults (10,000 units, 100 uploads, 100 searches)
YOUTUBE_DAILY_UNITS=
YOUTUBE_DAILY_UPLOADS=
YOUTUBE_DAILY_SEARCHES=
# YouTube Analytics reports a day: no limit until it's set
YOUTUBE_DAILY_ANALYTICS=

# ── TikTok ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 1 posts Shorts straight to creators' TikTok. Until TikTok's Direct Post audit
# passes, that only works for private accounts and the posts stay private
# (see NEXT.md). Without it, Shorts go to the creator's TikTok drafts.
TIKTOK_DIRECT_POST=
# 1 asks TikTok for each account's username (user.info.profile), which is how a
# LIVE counts as the creator's own. Only once the TikTok app has that scope:
# TikTok refuses the whole sign-in over a scope the app doesn't have.
TIKTOK_PROFILE=

# ── the LIVE bridge ──
# the public GitHub repo whose latest release has the bridge downloads (owner/name)
NEXT_PUBLIC_BRIDGE_REPO=r6snmkwsgg-web/hookline-bridge
# optional: an Euler Stream key, if TikTok signing starts refusing the bridge
EULER_API_KEY=
# 1 switches every Hookline Bridge off: each stops within 10 minutes and tells its game to use TikFinity
BRIDGE_OFF=

# ── worker and scripts ──
# a Chrome or Chrome Headless Shell for rendering, if Remotion shouldn't download its own
CHROME_PATH=

# ── tests ──
# a Postgres database whose name ends in _test: the database tests wipe it
TEST_DATABASE_URL=
